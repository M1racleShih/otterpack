+# ---------- 伴生样式表（HTML companion stylesheet） ----------
+#
+# 代码过滤默认挡住 .css（CODE_EXTS）。但 HTML 文档的呈现离不开伴生样式表，
+# 一刀切会让发布出去的 HTML 丢样式。精确放行：仅当 .css 被同一发布根内的
+# HTML 文档以 <link rel="stylesheet" href="…"> 引用时才可取；未被引用的
+# .css 与其余代码文件照旧不可见（列表不出现、直访 404）。
+# exclude 仍然最优先——被排除的 .css 即使被引用也拒绝。
+
+_LINK_TAG_RE = re.compile(r"<link\b[^>]*>", re.IGNORECASE)
+_ATTR_RE = re.compile(
+    r'''([a-zA-Z][a-zA-Z0-9_-]*)\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'=<>`]+))'''
+)
+# 外链/协议/根绝对路径：不属于「伴生」，不做放行
+_EXTERNAL_HREF_RE = re.compile(r"^(?:[a-zA-Z][a-zA-Z0-9+.-]*:|//|/)")
+
+
+def html_stylesheet_refs(text: str, base_dir: str) -> set[str]:
+    """提取 HTML 文档引用的伴生样式表，返回发布根相对 posix 路径集合。
+
+    - 只收 ``<link rel="stylesheet" href="相对路径">``；外链、带协议、
+      根绝对路径（``/…``）都不收；
+    - href 去掉 query/fragment，按 base_dir（HTML 所在目录）解析 ``..``；
+    - 解析后越出发布根的引用直接丢弃。
+    """
+    refs: set[str] = set()
+    base_parts = [p for p in (base_dir or "").replace("\\", "/").split("/") if p and p != "."]
+    for tag in _LINK_TAG_RE.findall(text):
+        attrs: dict[str, str] = {}
+        for match in _ATTR_RE.finditer(tag):
+            value = next((g for g in match.groups()[1:] if g is not None), "")
+            attrs[match.group(1).lower()] = value
+        if "stylesheet" not in (attrs.get("rel") or "").lower().split():
+            continue
+        href = (attrs.get("href") or "").strip()
+        href = href.split("#", 1)[0].split("?", 1)[0].strip()
+        if not href or _EXTERNAL_HREF_RE.match(href):
+            continue
+        parts = list(base_parts)
+        escaped = False
+        for seg in href.replace("\\", "/").split("/"):
+            if seg in ("", "."):
+                continue
+            if seg == "..":
+                if not parts:
+                    escaped = True
+                    break
+                parts.pop()
+            else:
+                parts.append(seg)
+        if escaped:
+            continue
+        refs.add("/".join(parts))
+    return refs
+
+
+class CompanionStylesheets:
+    """判定 .css 是否为发布根内某 HTML 文档的伴生样式表。
+
+    扫描有上限（文件数/单文件大小），结果带 TTL 缓存，避免客户端反复
+    触发整树扫描。规模超限按「不是伴生」处理（保守拒绝）。
+    """
+
+    def __init__(self, *, max_files: int = 400, max_file_bytes: int = 2_000_000,
+                 ttl: float = 30.0, max_cache: int = 512):
+        self.max_files = max_files
+        self.max_file_bytes = max_file_bytes
+        self.ttl = ttl
+        self.max_cache = max_cache
+        self._cache: dict[tuple, tuple[float, bool]] = {}
+        self._lock = threading.Lock()
+
+    def referenced(self, root: str, css_rel: str, *, skip_hidden: bool = True,
+                   excludes: list[str] | None = None) -> bool:
+        """css_rel（发布根相对路径）是否为某 HTML 文档的伴生样式表。
+
+        exclude 优先：被排除的 .css 即使被引用也不放行（与 _resolve 的
+        服务端强制双保险）。
+        """
+        css_rel = (css_rel or "").replace("\\", "/").strip("/")
+        if not css_rel.lower().endswith(".css"):
+            return False
+        compiled = compile_excludes(excludes or [])
+        if compiled and excluded(css_rel, compiled):
+            return False
+        root_real = os.path.realpath(root)
+        key = (root_real, css_rel, skip_hidden, tuple(excludes or []))
+        now = time.monotonic()
+        with self._lock:
+            hit = self._cache.get(key)
+            if hit and now - hit[0] < self.ttl:
+                return hit[1]
+        result = self._scan(root_real, css_rel, skip_hidden, compiled)
+        with self._lock:
+            if len(self._cache) >= self.max_cache:
+                self._cache.clear()
+            self._cache[key] = (now, result)
+        return result
+
+    def _scan(self, root_real: str, css_rel: str, skip_hidden: bool,
+              compiled: list) -> bool:
+        seen = 0
+        for dirpath, dirnames, filenames in os.walk(root_real, followlinks=False):
+            rel_dir = os.path.relpath(dirpath, root_real).replace(os.sep, "/")
+            if rel_dir == ".":
+                rel_dir = ""
+            if skip_hidden:
+                dirnames[:] = [d for d in dirnames if not d.startswith(".")]
+            if compiled:
+                dirnames[:] = [
+                    d for d in dirnames
+                    if not excluded("/".join(p for p in (rel_dir, d) if p), compiled, is_dir=True)
+                ]
+            for name in filenames:
+                if skip_hidden and name.startswith("."):
+                    continue
+                if not name.lower().endswith((".html", ".htm")):
+                    continue
+                child_rel = "/".join(p for p in (rel_dir, name) if p)
+                if compiled and excluded(child_rel, compiled):
+                    continue
+                seen += 1
+                if seen > self.max_files:
+                    return False
+                full = os.path.join(dirpath, name)
+                if os.path.islink(full):
+                    continue  # 符号链接不当作引用来源
+                try:
+                    if os.path.getsize(full) > self.max_file_bytes:
+                        continue
+                    with open(full, "r", encoding="utf-8", errors="replace") as fh:
+                        text = fh.read()
+                except OSError:
+                    continue
+                if css_rel in html_stylesheet_refs(text, rel_dir):
+                    return True
+        return False
+
+
