+    def test_an_unknown_session_cookie_is_rejected(self):
+        with loaded_relay(relay_token=TOKEN) as relay:
+            resp = request(relay, "/", BROWSER + [("Cookie", f"{relay.AUTH_SESSION_COOKIE}=made-up")])
+            self.assertEqual(resp.status, 401)
+
+    def test_the_legacy_raw_token_cookie_still_works_and_is_upgraded(self):
+        """An already-logged-in phone must not be bounced by the upgrade."""
+        with loaded_relay(relay_token=TOKEN) as relay:
+            resp = request(relay, "/", BROWSER + [("Cookie", f"herdr_token={TOKEN}")])
+            self.assertEqual(resp.status, 200)
+            self.assertTrue(cookie_value(resp, relay.AUTH_SESSION_COOKIE))
+
+    def test_a_session_survives_a_restart(self):
+        with loaded_relay(relay_token=TOKEN) as relay:
+            boot = request(relay, f"/?token={TOKEN}", BROWSER)
+            sid = cookie_value(boot, relay.AUTH_SESSION_COOKIE)
+            relay._save_auth_sessions()
+            relay.auth_sessions = {}
+            relay._load_auth_sessions()
+            self.assertIn(sid, relay.auth_sessions)
+
+    def test_token_rotation_retires_issued_sessions(self):
+        """Rotating HERDR_RELAY_TOKEN must not leave old sessions standing."""
+        with loaded_relay(relay_token=TOKEN) as relay:
+            boot = request(relay, f"/?token={TOKEN}", BROWSER)
+            sid = cookie_value(boot, relay.AUTH_SESSION_COOKIE)
+            relay.AUTH_TOKEN = "rotated-secret"
+            relay._load_auth_sessions()
+            self.assertNotIn(sid, relay.auth_sessions)
+            resp = request(relay, "/", BROWSER + [("Cookie", f"{relay.AUTH_SESSION_COOKIE}={sid}")])
+            self.assertEqual(resp.status, 401)
+
+    def test_a_corrupt_sessions_file_costs_sessions_not_startup(self):
+        with loaded_relay(relay_token=TOKEN) as relay:
+            with open(relay.AUTH_SESSIONS_FILE, "w") as f:
+                f.write("{not json")
+            relay._load_auth_sessions()
+            self.assertEqual(relay.auth_sessions, {})
+
+    def test_an_old_token_fingerprint_in_the_file_is_dropped_on_load(self):
+        with loaded_relay(relay_token=TOKEN) as relay:
+            with open(relay.AUTH_SESSIONS_FILE, "w") as f:
+                f.write('{"stale-id": "not-this-token", "fresh-id": "%s"}'
+                        % relay._token_fingerprint())
+            relay._load_auth_sessions()
+            self.assertEqual(list(relay.auth_sessions), ["fresh-id"])
+
+
+class UnchangedFlowsTests(unittest.TestCase):
+    def test_bearer_auth_still_works(self):
+        with loaded_relay(relay_token=TOKEN) as relay:
+            resp = request(relay, "/", [("Authorization", f"Bearer {TOKEN}"), ("Accept", "*/*")])
+            self.assertEqual(resp.status, 200)
+            self.assertNotIn(b"location.replace(location.pathname", resp.body)
+
+    def test_a_wrong_token_is_rejected_and_gets_no_session(self):
+        with loaded_relay(relay_token=TOKEN) as relay:
+            resp = request(relay, "/?token=wrong-token", BROWSER)
