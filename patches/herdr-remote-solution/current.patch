@@ -0,0 +1,219 @@
+"""How a browser gets from ?token= to a session cookie -- and what must not change for the rest.
+
+OWASP is blunt about URL tokens: they land in browser history, proxy logs, Referer headers and
+bookmarks. The relay's answer is the bootstrap hop -- the one browser load that carries ?token=
+is exchanged for a `__Host-` session cookie and the bare URL (via location.replace, so the
+tokened entry is replaced rather than left behind) before the app renders at all. Everything
+that is not a browser navigation -- curl, the native clients, the WebSocket handshake, the
+event push -- keeps the `?token=` semantics it already had.
+"""
+import asyncio
+import unittest
+
+from test_herdr_relay import loaded_relay
+
+TOKEN = "secret-token"
+
+
+class _Headers:
+    def __init__(self, items):
+        self._items = list(items)
+
+    def raw_items(self):
+        return list(self._items)
+
+
+class _Request:
+    def __init__(self, path="/", headers=(), method="GET"):
+        self.path = path
+        self.method = method
+        self.headers = _Headers(headers)
+
+
+def request(relay, path, headers=(), method="GET"):
+    return asyncio.run(relay.process_request(None, _Request(path, headers, method)))
+
+
+def set_cookie(response, name):
+    """The full Set-Cookie line for one cookie name, or None."""
+    for key, value in response.headers.raw_items():
+        if key.lower() == "set-cookie" and value.split("=", 1)[0] == name:
+            return value
+    return None
+
+
+def cookie_value(response, name):
+    header = set_cookie(response, name)
+    return header.split(";", 1)[0].split("=", 1)[1] if header else None
+
+
+BROWSER = [("Accept", "text/html")]
+
+
+class BootstrapHopTests(unittest.TestCase):
+    def test_a_browser_load_with_token_gets_the_exchange_page(self):
+        with loaded_relay(relay_token=TOKEN) as relay:
+            resp = request(relay, f"/?token={TOKEN}", BROWSER)
+            self.assertEqual(resp.status, 200)
+            self.assertIn(b"location.replace(location.pathname", resp.body)
+
+    def test_the_token_is_never_rendered_into_the_page(self):
+        """The script reads it off location.search; the HTML itself must stay static and clean."""
+        with loaded_relay(relay_token=TOKEN) as relay:
+            resp = request(relay, f"/?token={TOKEN}", BROWSER)
+            self.assertNotIn(TOKEN.encode(), resp.body)
+
+    def test_the_exchange_plants_a_session_cookie_that_is_not_the_token(self):
+        with loaded_relay(relay_token=TOKEN) as relay:
+            resp = request(relay, f"/?token={TOKEN}", BROWSER)
+            sid = cookie_value(resp, relay.AUTH_SESSION_COOKIE)
+            self.assertTrue(sid)
+            self.assertNotEqual(sid, TOKEN)
+            self.assertNotIn(TOKEN, set_cookie(resp, relay.AUTH_SESSION_COOKIE))
+
+    def test_the_session_cookie_is_hardened(self):
+        """__Host- prefix + Secure + HttpOnly + SameSite=Lax + Path=/, no Domain -- host-pinned."""
+        with loaded_relay(relay_token=TOKEN) as relay:
+            resp = request(relay, f"/?token={TOKEN}", BROWSER)
+            header = set_cookie(resp, relay.AUTH_SESSION_COOKIE)
+            self.assertTrue(relay.AUTH_SESSION_COOKIE.startswith("__Host-"))
+            for attribute in ("Secure", "HttpOnly", "SameSite=Lax", "Path=/"):
+                self.assertIn(attribute, header)
+            self.assertNotIn("Domain", header)
+
+    def test_the_exchange_page_is_never_cached(self):
+        with loaded_relay(relay_token=TOKEN) as relay:
+            resp = request(relay, f"/?token={TOKEN}", BROWSER)
+            cache = [v for k, v in resp.headers.raw_items() if k.lower() == "cache-control"]
+            self.assertIn("no-store", cache)
+
+    def test_deep_link_parameters_survive_the_exchange(self):
+        """A push opens /?pane=...&token=... -- pane must land, token must not."""
+        with loaded_relay(relay_token=TOKEN) as relay:
+            resp = request(relay, f"/?pane=w1p2&token={TOKEN}", BROWSER)
+            self.assertIn(b"params.delete('token')", resp.body)
+            self.assertIn(b"location.pathname + (q ? '?' + q : '')", resp.body)
+
+
+class SessionCookieTests(unittest.TestCase):
+    def test_the_session_cookie_authenticates_the_real_app(self):
+        with loaded_relay(relay_token=TOKEN) as relay:
+            boot = request(relay, f"/?token={TOKEN}", BROWSER)
+            sid = cookie_value(boot, relay.AUTH_SESSION_COOKIE)
+            resp = request(relay, "/", BROWSER + [("Cookie", f"{relay.AUTH_SESSION_COOKIE}={sid}")])
