@@ -0,0 +1,24 @@
+/** Real-host test wrapper: synthetic acquisition only, never a real Key/network.
+ * Uses the production controller/event wiring with injectable quota dependencies.
+ */
+import { HudController, OBSERVED_EVENTS, STREAM_EVENTS } from "../../src/extension.ts";
+
+export default function newapiHudFixture(pi) {
+  const controller = new HudController(pi, {
+    quotaAuthResolver: async () => ({ apiKey: "synthetic-not-a-secret", baseUrl: "https://newapi.example/v1" }),
+    quotaFetch: async (url, init) => {
+      if (init.method !== "GET" || init.redirect !== "error" || init.credentials !== "omit") throw new Error("invalid transport policy");
+      let payload;
+      if (url === "https://newapi.example/api/usage/token/") {
+        if (init.headers.Authorization !== "Bearer synthetic-not-a-secret") throw new Error("invalid synthetic auth");
+        payload = { code: true, data: { total_available: 20534246, total_used: 123, total_granted: 20534370, unlimited_quota: false, expires_at: 0 } };
+      } else if (url === "https://newapi.example/api/status") {
+        if (Object.keys(init.headers).some((name) => name.toLowerCase() === "authorization")) throw new Error("public status must not receive auth");
+        payload = { success: true, data: { quota_per_unit: 500000, quota_display_type: "CNY", usd_exchange_rate: 7.3, display_in_currency: true } };
+      } else throw new Error("unrecognized fixture endpoint");
+      return { status: 200, ok: true, headers: { get: () => null }, text: async () => JSON.stringify(payload) };
+    },
+  });
+  for (const name of [...OBSERVED_EVENTS, ...STREAM_EVENTS]) pi.on(name, (event, ctx) => controller.handle(name, event, ctx));
+  pi.registerCommand("hud", { description: "Synthetic NewAPI HUD test", handler: (args, ctx) => controller.command(args, ctx) });
+}
diff --git a/tests/kimi.test.mjs b/tests/kimi.test.mjs
