@@ -0,0 +1,232 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { normalizeConfig, normalizeQuotaProfile } from "../src/config.ts";
+import { newapiParse, newapiPrepare, newapiStatusParse, newapiAmount, validNewApiMetering } from "../src/quota/adapters/newapi.ts";
+import { QuotaService } from "../src/quota/service.ts";
+import { formatHud } from "../src/render.ts";
+import { formatFooter } from "../src/footer.ts";
+import { quotaFetch } from "../src/quota/transport.ts";
+import { controllerFixture } from "./helpers.mjs";
+
+const profile = { id: "key", providerId: "newapi", adapter: "newapi", source: "pi", origin: "https://newapi.example" };
+const auth = { apiKey: "synthetic-key", baseUrl: "https://newapi.example/v1" };
+const fields = { total_available: 20534246, total_used: 123, total_granted: 20534370, unlimited_quota: false, expires_at: 1893456000 };
+const usage = (overrides = {}) => JSON.stringify({ code: true, message: "ok", data: { ...fields, ...overrides } });
+const meter = { quotaPerUnit: 500000, displayType: "CNY", usdExchangeRate: 7.3 };
+const status = JSON.stringify({ success: true, data: { quota_per_unit: 500000, quota_display_type: "CNY", usd_exchange_rate: 7.3, display_in_currency: true } });
+const parse = (body) => newapiParse(200, null, body, { now: 1 });
+const response = (body, code = 200) => ({ status: code, headers: { get: () => null }, text: async () => body });
+const flush = async () => { for (let i = 0; i < 12; i++) await new Promise((resolve) => setTimeout(resolve, 1)); };
+
+test("NewAPI explicit HTTPS config and strict effective origin", () => {
+  assert.equal(normalizeQuotaProfile(profile).adapter, "newapi");
+  assert.equal(newapiPrepare({ profile, auth }).url, `${profile.origin}/api/usage/token/`);
+  assert.equal(normalizeQuotaProfile({ ...profile, origin: "https://newapi.example:443" }).origin, profile.origin);
+  assert.throws(() => normalizeQuotaProfile({ ...profile, origin: "https://newapi.example:99999" }));
+  for (const baseUrl of [undefined, "http://newapi.example/v1", "https://elsewhere.example/v1", "https://newapi.example:8443/v1", "https://user:pass@newapi.example/v1", "https://newapi.example/v1?q=1", "https://newapi.example/v1#x"]) {
+    assert.equal(newapiPrepare({ profile, auth: { ...auth, baseUrl } }).kind, "issue");
+  }
+  for (const origin of [undefined, "http://newapi.example", "https://newapi.example/x", "https://u:p@newapi.example", "https://newapi.example?q=1", "https://newapi.example#x"]) assert.throws(() => normalizeQuotaProfile({ ...profile, origin }));
+  for (const metering of [{}, { ...meter, quotaPerUnit: 0 }, { ...meter, usdExchangeRate: undefined }, { ...meter, extra: true }]) assert.throws(() => normalizeQuotaProfile({ ...profile, metering }));
+});
+
+test("NewAPI strict envelope, safe raw integers, seconds expiry, unlimited negatives", () => {
+  const key = parse(usage()).snapshot.keyQuota;
+  assert.equal(key.granted, fields.total_granted); // not re-summed
+  assert.equal(key.expiresAt, 1893456000000);
+  assert.equal(parse(usage({ expires_at: 0, total_available: 0 })).snapshot.keyQuota.expiresAt, null);
+  assert.equal(parse(usage({ unlimited_quota: true, total_available: -25 })).snapshot.keyQuota.remaining, -25);
+  for (const name of Object.keys(fields)) for (const invalid of [undefined, null, "0", 1.5, Number.MAX_SAFE_INTEGER + 1]) {
+    assert.equal(parse(usage({ [name]: invalid })).kind, "issue", `${name}: ${invalid}`);
+  }
+  assert.equal(parse('{"code":false,"message":"secret"}').issue.code, "business-error");
+  for (const body of ['{}', '{"success":true,"data":{}}', '{"code":200}', 'invalid']) assert.equal(parse(body).issue.code, "protocol-error");
+  for (const code of [401, 403, 429]) assert.equal(newapiParse(code, null, "private", { now: 1 }).kind, "issue");
+});
+
+test("NewAPI decimal integer rounding and public metadata whitelist", () => {
+  assert.equal(newapiAmount(fields.total_available, meter), "299.80");
+  assert.equal(newapiAmount(2500, { quotaPerUnit: 500000, displayType: "USD" }), "0.0050");
+  assert.equal(newapiAmount(-2500, { quotaPerUnit: 500000, displayType: "USD" }), "-0.0050");
+  assert.equal(newapiAmount(25, { quotaPerUnit: 500000, displayType: "USD" }), "0.0001");
+  assert.equal(newapiAmount(1, { quotaPerUnit: 500000, displayType: "USD" }), "0.0001");
+  assert.equal(newapiAmount(500000, { quotaPerUnit: 500000, displayType: "USD" }), "1.00");
+  assert.equal(newapiAmount(502500, { quotaPerUnit: 500000, displayType: "USD" }), "1.01");
+  assert.equal(newapiAmount(123, null), "123");
+  assert.equal(newapiAmount(Number.MAX_SAFE_INTEGER, { quotaPerUnit: 1, displayType: "USD" }), "9007199254740991.00");
+  assert.deepEqual(newapiStatusParse(200, status), meter);
+  assert.equal(newapiStatusParse(503, status), null);
+  assert.equal(newapiStatusParse(200, '{}'), null);
+  assert.equal(validNewApiMetering({ ...meter, usdExchangeRate: 0 }), null);
+  assert.equal(validNewApiMetering({ ...meter, usdExchangeRate: 1e-9 }), null);
+  assert.ok(validNewApiMetering({ ...meter, usdExchangeRate: 1e-8 }));
+  assert.equal(newapiAmount(50000000000000, { ...meter, usdExchangeRate: 1e-8 }), "1.00");
+});
+
+async function serviceFixture(fetch, overrides = {}) {
+  const service = new QuotaService({ fetch, resolveAuth: async () => auth, ...overrides });
+  service.configure(normalizeConfig({ quota: { enabled: true, profiles: [profile] } }).quota);
+  service.onModel({ provider: "newapi", id: "flash" });
+  await flush();
+  return service;
+}
+
+test("NewAPI status is unauthenticated, per-origin TTL, shared Key across models, details and currency", async () => {
+  const calls = [];
+  const service = await serviceFixture(async (url, init) => { calls.push({ url, init }); return response(url.endsWith("/api/status") ? status : usage()); });
+  try {
+    assert.equal(calls.length, 2);
+    assert.equal(calls[0].init.headers.Authorization, "Bearer synthetic-key");
+    assert.deepEqual(calls[1].init.headers, { Accept: "application/json" });
+    assert.equal(service.view().keyQuota.remainingText, "299.80");
+    service.onModel({ provider: "newapi", id: "pro" });
+    assert.equal(service.view().keyQuota, undefined);
+    await flush();
+    assert.equal(calls.length, 2);
+    assert.equal(service.inspect().profileList[0].cache.lastSuccess.keyQuota.meteringSource, "status");
+    assert.ok(!JSON.stringify(service.inspect()).includes("synthetic-key"));
+  } finally { service.dispose(); }
+});
+
+test("NewAPI status failure preserves raw snapshot and config overrides avoid metadata query", async () => {
+  const service = await serviceFixture(async (url) => response(url.endsWith("/api/status") ? '{}' : usage()));
+  assert.equal(service.view().keyQuota.currency, "quota");
+  service.configure(normalizeConfig({ quota: { enabled: true, profiles: [{ ...profile, metering: meter }] } }).quota);
+  await flush();
+  assert.equal(service.view().keyQuota.currency, "CNY");
+  service.dispose();
+});
+
+test("NewAPI key rotation, origin mismatch and metadata change remove old formatted values", async () => {
+  let currentAuth = auth;
+  let calls = 0;
+  const service = await serviceFixture(async (url) => { calls++; return response(url.endsWith("/api/status") ? status : usage()); }, { resolveAuth: async () => currentAuth });
+  currentAuth = { ...auth, apiKey: "second-synthetic-key" };
+  service.notify("settled"); await flush();
+  assert.equal(calls, 3); // status shared across keys
+  currentAuth = { ...currentAuth, baseUrl: "https://other.example/v1" };
+  service.notify("settled"); await flush();
+  assert.equal(calls, 3);
+  assert.equal(service.view().keyQuota, null);
+  currentAuth = auth;
+  service.configure(normalizeConfig({ quota: { enabled: true, profiles: [{ ...profile, metering: { quotaPerUnit: 500000, displayType: "USD" } }] } }).quota);
+  await flush();
+  assert.equal(service.view().keyQuota.remainingText, "41.07");
+  service.dispose();
+});
+
+test("NewAPI off aborts network and refuses late publish", async () => {
+  let signal;
+  let finish;
+  const service = new QuotaService({ resolveAuth: async () => auth, fetch: async (_url, init) => { signal = init.signal; return await new Promise((resolve) => { finish = resolve; }); } });
+  service.configure(normalizeConfig({ quota: { enabled: true, profiles: [profile] } }).quota);
+  service.onModel({ provider: "newapi", id: "flash" }); await flush();
+  service.configure(normalizeConfig().quota);
+  assert.equal(signal.aborted, true);
+  finish(response(usage())); await flush();
+  assert.equal(service.counters.published, 0);
+  assert.equal(service.view(), null);
+  service.dispose();
+});
+
+test("NewAPI metadata expiry changes formatted values without idle polling", async () => {
+  let now = 1000;
+  let calls = 0;
+  let metadata = status;
+  const service = await serviceFixture(async (url) => { calls++; return response(url.endsWith("/api/status") ? metadata : usage()); }, { now: () => now });
+  assert.equal(service.view().keyQuota.currency, "CNY");
+  now += 300001;
+  metadata = JSON.stringify({ success: true, data: { quota_per_unit: 500000, quota_display_type: "USD", display_in_currency: true } });
+  assert.equal(calls, 2);
+  service.notify("settled"); await flush();
+  assert.equal(calls, 4);
+  assert.equal(service.view().keyQuota.currency, "USD");
+  assert.equal(service.view().keyQuota.remainingText, "41.07");
+  service.dispose();
+});
+
+test("NewAPI site metering changes invalidate every cached Key at that origin", async () => {
+  let now = 1000;
+  let currentAuth = auth;
+  let metadata = status;
+  let calls = 0;
+  const service = await serviceFixture(async (url) => { calls++; return response(url.endsWith("/api/status") ? metadata : usage()); }, { now: () => now, resolveAuth: async () => currentAuth });
+  now += 200000;
