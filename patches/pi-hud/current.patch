+++ b/tests/kimi.test.mjs
@@ -0,0 +1,108 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { normalizeConfig, normalizeQuota } from "../src/config.ts";
+import { kimiPrepare, kimiParse } from "../src/quota/adapters/kimi.ts";
+import { QuotaService } from "../src/quota/service.ts";
+import { quotaField, LABELS } from "../src/render.ts";
+import { FakeClock } from "./helpers.mjs";
+
+const profile = { id: "kimi-code", providerId: "kimi-coding", adapter: "kimi", source: "pi" };
+const auth = { apiKey: "synthetic-key", baseUrl: "https://api.kimi.com/coding/v1" };
+const parse = (data, status = 200, headers = null) => kimiParse(status, headers, JSON.stringify(data), { now: 1_000 });
+const sample = { usages: {
+  limit_5h: { used_ratio: 0.1202, reset_time: "2026-10-21T04:51:17Z" },
+  limit_7d: { used_ratio: 0.0242, reset_time: "2026-10-24T03:51:17Z" },
+} };
+const flush = async () => { for (let i = 0; i < 8; i++) await new Promise(resolve => setImmediate(resolve)); };
+
+test("Kimi profile accepts only its fixed origin and Pi source", () => {
+  assert.equal(normalizeQuota({ profiles: [profile] }).profiles[0].adapter, "kimi");
+  assert.doesNotThrow(() => normalizeQuota({ profiles: [{ ...profile, origin: "https://api.kimi.com" }] }));
+  assert.throws(() => normalizeQuota({ profiles: [{ ...profile, origin: "https://relay.example" }] }), /origin must be/);
+  assert.throws(() => normalizeQuota({ profiles: [{ ...profile, source: "codex-app-server" }] }), /not valid/);
+});
+
+test("Kimi prepare uses a fixed read-only URL and one Bearer prefix", () => {
+  const request = kimiPrepare({ profile, auth });
+  assert.deepEqual(request, { kind: "request", url: "https://api.kimi.com/coding/v1/usages", headers: { Accept: "application/json", Authorization: "Bearer synthetic-key" } });
+  assert.equal(kimiPrepare({ profile, auth: { ...auth, apiKey: "Bearer synthetic-key" } }).headers.Authorization, "Bearer synthetic-key");
+});
+
+test("Kimi prepare refuses relay, Moonshot API, unverified global and missing endpoints before credentials leave", () => {
+  for (const baseUrl of ["https://relay.example/v1", "https://api.moonshot.cn/v1", "https://api.kimi.ai/coding/v1", "http://api.kimi.com/coding/v1", "https://api.kimi.com@evil.example/v1", "", undefined]) {
+    assert.equal(kimiPrepare({ profile, auth: { ...auth, baseUrl } }).issue.code, "needs-verification");
+  }
+  assert.equal(kimiPrepare({ profile: { ...profile, origin: "https://evil.example" }, auth }).issue.code, "needs-verification");
+  assert.equal(kimiPrepare({ profile, auth: { ...auth, apiKey: "" } }).issue.code, "needs-auth");
+});
+
+test("Kimi ratios remain separate 5h and weekly windows with RFC3339 reset times", () => {
+  const result = parse(sample);
+  assert.equal(result.kind, "snapshot");
+  const [fiveHour, week] = result.snapshot.buckets;
+  assert.deepEqual(fiveHour.window, { unit: "hour", number: 5 });
+  assert.deepEqual(week.window, { unit: "week", number: 1 });
+  assert.ok(Math.abs(fiveHour.remainingPercent - 87.98) < 1e-10);
+  assert.ok(Math.abs(week.remainingPercent - 97.58) < 1e-10);
+  assert.equal(fiveHour.resetAt, Date.parse("2026-10-21T04:51:17Z"));
+  assert.equal(result.snapshot.partial, false);
+});
+
+test("Kimi monthly total and code quotas remain distinct detail buckets", () => {
+  const result = parse({ usages: { limit_month_total: { used_ratio: "0.2" }, limit_month_code: { used_ratio: "0.3" } } });
+  assert.deepEqual(result.snapshot.buckets.map(b => b.id), ["limit_month_total", "limit_month_code"]);
+  assert.deepEqual(result.snapshot.buckets.map(b => b.remainingPercent), [80, 70]);
+});
+
+test("Kimi zero/full/overrun ratios are finite display percentages; bad reset stays unknown", () => {
+  for (const [used_ratio, remaining] of [[0, 100], [1, 0], [1.2, 0], [-0.1, 100]]) {
+    const bucket = parse({ usages: { limit_5h: { used_ratio, reset_time: "invalid" } } }).snapshot.buckets[0];
+    assert.equal(bucket.remainingPercent, remaining);
+    assert.equal(bucket.resetAt, undefined);
+  }
+  assert.equal(parse({ usages: { limit_5h: { used_ratio: 0, reset_time: "2026-10-21" } } }).snapshot.buckets[0].resetAt, undefined);
+});
+
+test("Kimi missing and malformed data never become zero or unlimited", () => {
+  assert.equal(parse({}).issue.code, "protocol-error");
+  assert.equal(parse({ usages: {} }).issue.code, "no-data");
+  assert.equal(kimiParse(200, null, "not JSON", { now: 0 }).issue.code, "protocol-error");
+  for (const used_ratio of [null, true, "", " ", "NaN", "Infinity", {}, "1e999"]) {
+    assert.equal(parse({ usages: { limit_5h: { used_ratio } } }).issue.code, "protocol-error");
+  }
+  const partial = parse({ usages: { ...sample.usages, limit_month_total: { used_ratio: null } } });
+  assert.equal(partial.snapshot.partial, true);
+  assert.equal(partial.snapshot.ignoredBuckets, 1);
+  assert.equal(partial.snapshot.buckets.length, 2);
+});
+
+test("Kimi HTTP errors use existing auth and Retry-After semantics without echoing bodies", () => {
+  assert.equal(parse({ secret: "must-not-echo" }, 401).issue.code, "needs-auth");
+  assert.equal(parse({}, 403).issue.code, "forbidden");
+  assert.equal(parse({}, 429, { get: () => "12" }).issue.retryAt, 13_000);
+  assert.equal(parse({}, 500).issue.code, "http-error");
+});
+
+test("Kimi service resolves Pi auth, renders remaining windows and reuses account quota across models", async () => {
+  const clock = new FakeClock(); let calls = 0;
+  const service = new QuotaService({ now: clock.now, setTimer: clock.setTimer, clearTimer: clock.clearTimer,
+    resolveAuth: async () => auth,
+    fetch: async (url, init) => {
+      calls++;
+      assert.equal(url, "https://api.kimi.com/coding/v1/usages");
+      assert.equal(init.method, "GET"); assert.equal(init.redirect, "error"); assert.equal(init.credentials, "omit");
+      return { status: 200, ok: true, headers: { get: () => null }, text: async () => JSON.stringify(sample) };
+    },
+  });
+  try {
+    service.configure(normalizeQuota({ enabled: true, profiles: [profile] }));
+    for (const id of ["kimi-for-coding", "kimi-for-coding-highspeed", "k3", "k3-256k"]) {
+      service.onModel({ provider: "kimi-coding", id }); await flush(); clock.advance(0); await flush();
+      const view = service.view(); assert.equal(view.status, "ready"); assert.equal(view.profileId, "kimi-code");
+      const field = quotaField(view, normalizeConfig({ language: "en" }), LABELS.en);
+      assert.equal(field.text, "Kimi Code · 5h 88% · wk 98%");
+    }
+    assert.equal(calls, 1);
+    assert(!JSON.stringify(service.inspect()).includes(auth.apiKey));
+  } finally { service.dispose(); }
+});
